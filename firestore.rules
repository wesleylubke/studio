
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isProjectMember(projectId) {
      let project = get(/databases/$(database)/documents/projects/$(projectId)).data;
      return request.auth.token.email in project.members || request.auth.uid == project.ownerId;
    }

    match /users/{userId} {
      allow get, write: if request.auth.uid == userId;
    }

    match /projects/{projectId} {
      allow list: if isSignedIn() && (resource.data.ownerId == request.auth.uid || request.auth.token.email in resource.data.members);
      allow get: if isSignedIn() && (resource.data.ownerId == request.auth.uid || request.auth.token.email in resource.data.members);
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isSignedIn() && (resource.data.ownerId == request.auth.uid || request.auth.token.email in resource.data.members);
      allow delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;

      match /tasks/{taskId} {
        allow read, write: if isSignedIn() && isProjectMember(projectId);
      }
    }
  }
}
