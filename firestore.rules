
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isProjectMember(projectId) {
      let projectPath = /databases/$(database)/documents/projects/$(projectId);
      return isSignedIn() && exists(projectPath) && (
        get(projectPath).data.ownerId == request.auth.uid || 
        (request.auth.token.email != null && request.auth.token.email in get(projectPath).data.members)
      );
    }

    match /users/{userId} {
      allow get, write: if request.auth.uid == userId;
    }

    match /projects/{projectId} {
      allow list, get: if isSignedIn() && (
        resource.data.ownerId == request.auth.uid || 
        (request.auth.token.email != null && request.auth.token.email in resource.data.members)
      );
      
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      
      allow update: if isSignedIn() && (
        resource.data.ownerId == request.auth.uid || 
        (request.auth.token.email != null && request.auth.token.email in resource.data.members)
      );
      
      allow delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;

      match /tasks/{taskId} {
        allow read, write: if isProjectMember(projectId);
      }
    }
  }
}
