
{
  "entities": {
    "User": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "User",
      "type": "object",
      "description": "Represents a user of the GanttFlow application.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the User entity (UID)."
        },
        "email": {
          "type": "string",
          "description": "The user's email address.",
          "format": "email"
        },
        "displayName": {
          "type": "string",
          "description": "The user's display name."
        },
        "photoURL": {
          "type": "string",
          "description": "The user's profile picture URL."
        }
      },
      "required": [
        "id",
        "email"
      ]
    },
    "Project": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Project",
      "type": "object",
      "description": "A project that can be shared between users.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the Project."
        },
        "name": {
          "type": "string",
          "description": "The name of the project."
        },
        "description": {
          "type": "string",
          "description": "A detailed description."
        },
        "status": {
          "type": "string",
          "description": "The current status of the project.",
          "enum": [
            "ongoing",
            "paused",
            "finished"
          ]
        },
        "ownerId": {
          "type": "string",
          "description": "The UID of the owner."
        },
        "ownerEmail": {
          "type": "string",
          "description": "The email of the owner."
        },
        "members": {
          "type": "array",
          "description": "List of user emails who have access to this project.",
          "items": {
            "type": "string"
          }
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "name",
        "ownerId",
        "ownerEmail",
        "members",
        "status"
      ]
    },
    "Task": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Task",
      "type": "object",
      "description": "An individual task within a project.",
      "properties": {
        "id": {
          "type": "string"
        },
        "projectId": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "startDate": {
          "type": "string"
        },
        "endDate": {
          "type": "string"
        },
        "progress": {
          "type": "number"
        },
        "assigneeEmails": {
          "type": "array",
          "description": "List of emails of the users assigned to this task.",
          "items": {
            "type": "string"
          }
        },
        "order": {
          "type": "number",
          "description": "Visual order of the task in the list."
        }
      },
      "required": [
        "id",
        "projectId",
        "name",
        "startDate",
        "endDate",
        "progress",
        "order"
      ]
    }
  },
  "auth": {
    "providers": [
      "google.com"
    ]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "#/entities/User",
      "description": "User profiles."
    },
    "/projects/{projectId}": {
      "schema": "#/entities/Project",
      "description": "Top-level projects for easier sharing."
    },
    "/projects/{projectId}/tasks/{taskId}": {
      "schema": "#/entities/Task",
      "description": "Tasks within a project."
    }
  }
}
